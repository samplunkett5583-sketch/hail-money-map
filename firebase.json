{
  "functions": [
    {
      "source": "functions-abc",
      "codebase": "abc"
    },
    {
      "source": "functions-drone",
      "codebase": "drone"
    },
    {
      "source": "functions-ai",
      "codebase": "ai"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/employee-test-login",
        "function": {
          "functionId": "employeeTestLogin",
          "region": "us-central1"
        }
      }
    ],
    "port": 5500
  },
  "emulators": {
    "functions": {
      "port": 5015
    },
    "hosting": {
      "port": 5500
    },
    "ui": {
      "enabled": true,
      "port": 4403
    }
  }
}


