{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "functions-abc",
      "codebase": "abc"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/employee/employeeTestLogin",
        "function": {
          "functionId": "employeeTestLogin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/employee/provisionEmployee",
        "function": {
          "functionId": "provisionEmployee",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/employee/bootstrapFirstAdmin",
        "function": {
          "functionId": "bootstrapFirstAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/employee/changeOwnPassword",
        "function": {
          "functionId": "changeOwnPassword",
          "region": "us-central1"
        }
      }
    ],
    "port": 5500
  },
  "emulators": {
    "functions": {
      "port": 5015
    },
    "hosting": {
      "port": 5500
    },
    "ui": {
      "enabled": true,
      "port": 4403
    }
  }
}
